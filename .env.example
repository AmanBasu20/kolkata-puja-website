# Kolkata Pujo Parikrama Web Configuration
# Keep this file secure; never commit .env to GitHub

# Google Gemini API key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API key (Free tier from https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI API Key (from https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic Claude API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022


# Live MCP Server URL
MCP_SERVER_URL=https://kolkata-puja-mcp-server2.onrender.com/mcp

# Optional bearer token for MCP server if enabled
MCP_SERVER_TOKEN=

# Free questions per user limit (shared across Gemini & Groq)
GUEST_LIMIT=5

# Port to serve
PORT=8000
